{
  "expo": {
    "name": "repere-mobile",
    "slug": "repere-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reperemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Repère utilise votre position pour trouver les espaces les plus proches et confirmer votre arrivée."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Repère utilise Face ID pour protéger l'accès à vos paramètres de sécurité."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Repère utilise l'appareil photo pour scanner le code d'un espace et confirmer votre arrivée.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
