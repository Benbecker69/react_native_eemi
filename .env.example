# Copy to .env (gitignored — this value is specific to this machine/session,
# not secret, see CLAUDE.md § Pièges "Backend depuis l'iPhone").
#
# The URL of the allow-list gateway (tools/api-gateway/), reached through an
# ngrok tunnel — not the Next.js server directly. Only /api/mobile/v1/* is
# reachable there; the website and /admin are not. Get the domain from your
# ngrok dashboard (Gateway → Domains), start the gateway with `npm run
# gateway`, then `ngrok http 3200 --url https://<your-domain>`.
#
# EXPO_PUBLIC_ values are inlined in plain text in the built app — fine here,
# this is a public tunnel URL, never a secret.
EXPO_PUBLIC_API_URL="https://your-subdomain.ngrok-free.dev"
